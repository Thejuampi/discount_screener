{
  "contract": "sec-driver-normalization",
  "version": "1",
  "fingerprint": "sec-driver-normalization/12",
  "scope": { "taxonomy": "us-gaap", "forms": ["10-K", "10-K/A"], "businessClass": "OperatingNonFinancial", "unit": "USD", "durationDays": [325, 380] },
  "operations": { "equivalent": "select_one_equivalent", "debt": "sum_disjoint_components", "effectiveTax": "derive", "marginalTax": "reference_policy", "nonRecurringCharge": "aggregate_or_sum_of_components" },
  "investmentCategories": {
    "development": ["PaymentsToAcquirePropertyPlantAndEquipment", "PaymentsToAcquireProductiveAssets", "PaymentsToAcquireOtherPropertyPlantAndEquipment", "PaymentsForCapitalImprovements", "PaymentsToExploreAndDevelopOilAndGasProperties"],
    "developmentSoftware": ["PaymentsForSoftware", "PaymentsToDevelopSoftware"],
    "developmentWells": ["PaymentsToAcquireOilAndGasPropertyAndEquipment"],
    "developmentIntangibles": ["PaymentsToAcquireIntangibleAssets"],
    "developmentAggregate": ["PaymentsToAcquireProductiveAssets"],
    "propertyAcquisition": [
      "PaymentsToAcquireOilAndGasProperty",
      "PaymentsToAcquireRoyaltyInterestsInMiningProperties",
      "PaymentsToAcquireMineralRights",
      "PaymentsToAcquireMiningAssets",
      "PaymentsToAcquireCommercialRealEstate",
      "PaymentsToAcquireAndDevelopRealEstate",
      "PaymentsToAcquireRealEstateHeldForInvestment",
      "PaymentsToAcquireHeldForSaleRealEstate",
      "PaymentsToAcquireOtherRealEstate",
      "PaymentsToAcquirePartnersInterestInRealEstatePartnershipNetOfCashAcquired",
      "PaymentsToAcquireWaterSystems",
      "PaymentsToAcquireWasteWaterSystems",
      "PaymentsToAcquireWaterAndWasteWaterSystems"
    ],
    "businessAcquisition": [
      "PaymentsToAcquireBusinessesNetOfCashAcquired",
      "PaymentsToAcquireBusinesses",
      "PaymentsToAcquireBusinessesGross",
      "PaymentsToAcquireBusinessesAndInterestInAffiliates",
      "OtherPaymentsToAcquireBusinesses",
      "PaymentsToAcquireBusinessInterests",
      "PaymentsToAcquireBusinessTwoNetOfCashAcquired",
      "PaymentsToAcquireBusinessThreeNetOfCashAcquired",
      "PaymentsToAcquireAdditionalInterestInSubsidiaries",
      "PaymentsToAcquireInterestInSubsidiariesAndAffiliates",
      "PaymentsToAcquireInterestInJointVenture",
      "PaymentsToAcquireLimitedPartnershipInterests"
    ]
  },
  "rejection": { "propertyAcquisition": "RejectedAcquisition", "businessAcquisition": "RejectedAcquisition", "unknown": "NoApprovedConcept", "invalidUnit": "InvalidUnit", "misalignedPeriod": "MisalignedPeriod" },
  "precedence": ["consolidated", "10-K/A", "filed_desc", "accession_desc", "declared_qname_order"],
  "fcffConsumption": "development_only",
  "developmentComposition": {
    "operation": "sum_disjoint_components",
    "components": ["development", "developmentSoftware", "developmentWells", "developmentIntangibles"],
    "rationale": "An issuer that invests through capitalized software development files nothing under the tangible CapEx concepts. Reading development alone reported FIS 2025 CapEx as $0.154B of plant while the issuer also paid $0.835B to develop software, overstating FCFF by 68%. The two are disjoint cash outflows on the same statement, not alternative tags for one line, so they are summed rather than selected between. EOG files the well program as PaymentsToAcquireOilAndGasPropertyAndEquipment and a smaller PaymentsToAcquireOtherPropertyPlantAndEquipment office/plant line. Those are also disjoint. Treating the well program as a property acquisition dropped ~$6.1B of recurring CapEx and invented a 45% FCFF margin. PaymentsToAcquireOilAndGasProperty (no equipment) remains acreage acquisition. Comcast files PaymentsToAcquireIntangibleAssets of $2.0–3.3B every year next to PPE. That line is spectrum, software, and license cash, not a business acquisition. Dropping it overstates FCFF. PaymentsToAcquireBusinesses stays rejected acquisition.",
    "suppressWellsWhenTangibleQnameIn": ["PaymentsToExploreAndDevelopOilAndGasProperties"],
    "wellsSuppressionRationale": "PaymentsToExploreAndDevelopOilAndGasProperties is already the well program. Adding PaymentsToAcquireOilAndGasPropertyAndEquipment on the same close would count the wells twice.",
    "suppressSoftwareWhenTangibleQnameIn": "developmentAggregate",
    "suppressIntangiblesWhenTangibleQnameIn": "developmentAggregate",
    "suppressionRationale": "The us-gaap definition of PaymentsToAcquireProductiveAssets is 'the cash outflow for purchases of and capital improvements on property, plant and equipment (capital expenditures), software, and other intangible assets' — software and other intangibles are inside the element by definition, unlike PaymentsToAcquirePropertyPlantAndEquipment, which is tangible by definition. Summing an aggregate with a component it already contains double counts, so when the selected tangible concept is an aggregate the software and intangible components are dropped."
  },
  "valuationPolicy": {
    "materialAcquisitionRevenueBps": 1000,
    "contaminatedTransition": "exclude_current_year_revenue_growth",
    "minimumCleanRecentGrowthTransitions": 2,
    "onLatestContaminatedOrInsufficientClean": "normalize_near_term_growth_to_zero",
    "nonRecurringChargeOperatingBps": 1500,
    "onNonRecurringChargeAboveThreshold": "mark_latest_earnings_contaminated"
  },
  "drivers": {
    "operatingCashFlow": {
      "qnames": ["NetCashProvidedByUsedInOperatingActivities", "NetCashProvidedByUsedInOperatingActivitiesContinuingOperations", "NetCashProvidedByUsedInOperatingActivitiesContinuingOperationsIncludingDiscontinuedOperation"],
      "unit": "USD",
      "periodShape": "duration",
      "operation": "select_one_equivalent"
    },
    "revenue": {
      "qnames": ["RevenueFromContractWithCustomerExcludingAssessedTax", "Revenues", "SalesRevenueNet", "SalesRevenueGoodsNet", "RevenueFromContractWithCustomerIncludingAssessedTax", "RevenuesFromExternalCustomers"],
      "unit": "USD",
      "periodShape": "duration",
      "operation": "select_one_equivalent"
    },
    "interestExpense": {
      "qnames": ["InterestExpenseNonOperating", "InterestExpenseNonoperating", "InterestExpenseDebt", "InterestAndDebtExpense", "InterestExpense", "InterestExpenseOtherLongTermDebt", "InterestIncomeExpenseNet", "InterestIncomeExpenseNonoperatingNet"],
      "unit": "USD",
      "periodShape": "duration",
      "operation": "select_one_equivalent",
      "rationale": "InterestPaidNet was removed. It is cash paid, not the accrued income-statement expense. FinanceLeaseInterestExpense was removed. It is the lease subset, not total interest. Lowe's 2020-2022 had only that subset (~$30M) next to ~$1.3B of net interest in later years, so coverage looked like AAA. InterestIncomeExpenseNet and InterestIncomeExpenseNonoperatingNet stay. They are income-statement nets. Issuers file them with either sign. Use the magnitude as the coupon. An issuer that files no approved interest expense reads as absent."
    },
    "totalDebt": {
      "qnames": ["DebtAndCapitalLeaseObligations", "LongTermDebtAndCapitalLeaseObligations", "LongTermDebtAndCapitalLeaseObligationsIncludingCurrentMaturities", "LongTermDebt", "DebtInstrumentCarryingAmount"],
      "unit": "USD",
      "periodShape": "instant",
      "operation": "select_one_equivalent"
    },
    "currentDebt": {
      "qnames": ["LongTermDebtAndFinanceLeaseObligationsCurrent", "LongTermDebtCurrent", "DebtCurrent", "ShortTermBorrowings"],
      "unit": "USD",
      "periodShape": "instant",
      "operation": "sum_disjoint_components"
    },
    "nonCurrentDebt": {
      "qnames": ["LongTermDebtAndFinanceLeaseObligationsNoncurrent", "LongTermDebtNoncurrent"],
      "unit": "USD",
      "periodShape": "instant",
      "operation": "sum_disjoint_components"
    },
    "stockholdersEquity": {
      "qnames": ["StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest", "StockholdersEquity", "PartnersCapitalIncludingPortionAttributableToNoncontrollingInterest", "PartnersCapital", "MembersEquity"],
      "unit": "USD",
      "periodShape": "instant",
      "operation": "select_one_equivalent",
      "rationale": "The equity half of invested capital. The NCI-inclusive tag leads because the return it will be divided into is consolidated (pretax income plus interest expense, both struck before the minority's share is removed); reading equity excluding NCI against a consolidated return overstates the return of every issuer carrying a material minority. select_one_equivalent, not a composition: issuers genuinely split debt across disjoint current and non-current lines, but total equity is one reported subtotal, and the components (CommonStockValue, AdditionalPaidInCapital, RetainedEarnings) omit AOCI when summed. LiabilitiesAndStockholdersEquity is excluded because it is total assets."
    },
    "taxExpense": {
      "qnames": ["IncomeTaxExpenseBenefit", "IncomeTaxExpenseBenefitContinuingOperations"],
      "unit": "USD",
      "periodShape": "duration",
      "operation": "derive_effective_tax"
    },
    "pretaxIncome": {
      "qnames": ["IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest", "IncomeLossFromContinuingOperationsBeforeIncomeTaxesMinorityInterestAndIncomeLossFromEquityMethodInvestments", "IncomeLossFromContinuingOperationsBeforeIncomeTaxes", "IncomeLossFromContinuingOperationsBeforeIncomeTaxesDomestic", "IncomeLossFromContinuingOperationsBeforeIncomeTaxesForeign"],
      "unit": "USD",
      "periodShape": "duration",
      "operation": "derive_effective_tax"
    },
    "marginalTaxReference": {
      "qnames": ["IncomeTaxReconciliationAtFederalStatutoryIncomeTaxRate", "IncomeTaxReconciliationFederalStatutoryIncomeTaxRate", "EffectiveIncomeTaxRateReconciliationAtFederalStatutoryIncomeTaxRate", "StatutoryFederalIncomeTaxRate", "StatutoryIncomeTaxRate"],
      "unit": "pure",
      "periodShape": "duration",
      "operation": "reference_policy"
    },
    "dilutedAverageShares": {
      "qnames": ["WeightedAverageNumberOfDilutedSharesOutstanding"],
      "unit": "shares",
      "periodShape": "duration",
      "operation": "select_one_equivalent"
    },
    "operatingIncome": {
      "qnames": ["OperatingIncomeLoss"],
      "unit": "USD",
      "periodShape": "duration",
      "operation": "select_one_equivalent"
    },
    "impairmentAggregate": {
      "qnames": ["AssetImpairmentCharges", "GoodwillAndIntangibleAssetImpairment"],
      "unit": "USD",
      "periodShape": "duration",
      "operation": "aggregate_or_sum_of_components"
    },
    "impairmentComponents": {
      "qnames": [
        "GoodwillImpairmentLoss",
        "ImpairmentOfIntangibleAssetsExcludingGoodwill",
        "TangibleAssetImpairmentCharges"
      ],
      "unit": "USD",
      "periodShape": "duration",
      "operation": "aggregate_or_sum_of_components"
    },
    "restructuringCharges": {
      "qnames": ["RestructuringCharges", "RestructuringCosts"],
      "unit": "USD",
      "periodShape": "duration",
      "operation": "select_one_equivalent"
    }
  }
}

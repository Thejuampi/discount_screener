  "contract": "industry-beta-policy",
  "version": "1",
  "policyVersion": "industry-beta-policy/1",
  "architecture": "_bmad-output/planning-artifacts/valuation-model-family-architecture.md",
  "notes": [
    "Versioned sector/industry levered-beta priors for CoE shrink. Sole industry-prior source for Windows dcf_model and Android DcfAnalysisEngine.",
    "Through-cycle industries (commodity E&P, integrated oil, specialty chemicals) carry higher priors so temporarily bond-like trailing betas are pulled toward cycle risk — not max(re, magic_constant) floors.",
    "Unmapped sector/industry uses defaultPrior with provisional provenance. No per-ticker floors. Price and analyst targets are never CoE inputs.",
    "Shrink weights are intentional Bayes/Blume estimation (company 67% / industry 33%). Match order: industryKey → industryNameContains → sectorKey → sectorNameContains → default."
  ],
  "shrink": {
    "companyWeightPct": 67,
    "industryWeightPct": 33
  },

{
  "contract": "valuation-model-family",
  "version": "2",
  "architecture": "_bmad-output/planning-artifacts/valuation-model-family-architecture.md",
  "notes": [
    "Golden cases for classifier, model selection, and executable policy/2 FCFF regressions.",
    "ACGL fundamentals sampled 2026-07-25 from public sources (Macrotrends/Yahoo/EDGAR/IR). T and AMZN inputs were sampled 2026-07-30 from Yahoo plus SEC companyfacts. Do not invent replacements without re-sampling."
  ],
  "policy2Adoption": {
    "executableSurfaces": ["windows", "android"],
    "deferredSurfaces": ["desktop"]
  },
  "forbiddenAcceptancePatterns": [
    "assert_intrinsic_over_price_ratio_bounded",
    "min_wacc_floor_as_valuation_truth",
    "sector_fcf_haircut_constant"
  ],
  "classifierCases": [
    {
      "name": "acgl_pc_insurance_is_financial_services",
      "symbol": "ACGL",
      "sectorName": "Financial Services",
      "industryName": "Insurance - Property & Casualty",
      "expectedBusinessClass": "FinancialServices",
      "expectedModel": "ResidualIncomeEquity",
      "mustNotUseModel": "FcffWacc"
    },
    {
      "name": "jpm_bank_is_financial_services",
      "symbol": "JPM",
      "sectorName": "Financial Services",
      "industryName": "Banks - Diversified",
      "expectedBusinessClass": "FinancialServices",
      "expectedModel": "ResidualIncomeEquity",
      "mustNotUseModel": "FcffWacc"
    },
    {
      "name": "ci_healthcare_plans_is_financial_services",
      "symbol": "CI",
      "sectorName": "Healthcare",
      "industryName": "Healthcare Plans",
      "sectorKey": "healthcare",
      "industryKey": "healthcare-plans",
      "expectedBusinessClass": "FinancialServices",
      "expectedModel": "ResidualIncomeEquity",
      "mustNotUseModel": "FcffWacc",
      "notes": "Managed care float must not run FCFF primary (same class of failure as ACGL)."
    },
    {
      "name": "pharma_stays_operating_fcff",
      "symbol": "PFE",
      "sectorName": "Healthcare",
      "industryName": "Drug Manufacturers - General",
      "expectedBusinessClass": "OperatingNonFinancial",
      "expectedModel": "FcffWacc"
    },
    {
      "name": "operating_industrial_uses_fcff",
      "symbol": "EXAMPLE_OPERATING",
      "sectorName": "Industrials",
      "industryName": "Specialty Industrial Machinery",
      "expectedBusinessClass": "OperatingNonFinancial",
      "expectedModel": "FcffWacc"
    },
    {
      "name": "etf_not_eligible",
      "symbol": "SPY",
      "sectorName": null,
      "industryName": null,
      "assetClassHint": "Etf",
      "expectedBusinessClass": "NotEligible",
      "expectedModel": "None"
    },
    {
      "name": "missing_sector_industry_unclassified_refuses_valuation",
      "symbol": "ZZZ",
      "sectorName": null,
      "industryName": null,
      "expectedBusinessClass": "Unclassified",
      "expectedModel": "None",
      "mustNotUseModel": "FcffWacc",
      "notes": "Closed-world classifier: no silent FCFF default when class is unknown."
    },
    {
      "name": "unknown_sector_text_unclassified",
      "symbol": "WEIRD",
      "sectorName": "Intergalactic Conglomerate",
      "industryName": "Moon Cheese",
      "expectedBusinessClass": "Unclassified",
      "expectedModel": "None",
      "mustNotUseModel": "FcffWacc"
    }
  ],

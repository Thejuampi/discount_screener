{
  "contract": "valuation-model-family",
  "version": "3",
  "architecture": "_bmad-output/planning-artifacts/valuation-model-family-architecture.md",
  "notes": [
    "Golden cases for classifier, model selection, and executable policy/2 FCFF regressions.",
    "ACGL fundamentals sampled 2026-07-25 from public sources (Macrotrends/Yahoo/EDGAR/IR). T and AMZN inputs were sampled 2026-07-30 from Yahoo plus SEC companyfacts. Do not invent replacements without re-sampling."
  ],
  "policy2Adoption": {
    "executableSurfaces": ["windows", "android"],
    "deferredSurfaces": ["desktop"]
  },
  "fcffRobustEvidencePolicy": {
    "modelPolicyVersion": "business-class-policy/37-latest-positive-fcff",
    "baseMargin": "owner_earnings_ocf_minus_maintenance_when_investment_wave_else_nonneg_annual_median_else_latest_positive",
    "scenarioMargins": "full_aligned_annual_including_negatives",
    "scenarioGrowth": "band_around_median_not_historical_iqr",
    "scenarioGrowthBandBps": 400,
    "maxNearGrowthDistanceFromStableBps": 1200,
    "secularNearGrowth": "min_of_raw_and_max_of_stable_band_and_half_demonstrated_capped_at_2500",
    "ocfLevel": "latest_when_recent_path_non_decreasing_else_median",
    "interestMissingYear": "zero_when_no_debt_else_confidence_estimate_or_absent",
    "couponResolution": "coupon-resolution/1-own-rate-or-peer-median",
    "debtResolution": "debt-resolution/1-stock-coupon-kd",
    "issuerMarketYield": "issuer-market-yield/2-current-kd-keeps-tax-years",
    "issuerMarketYieldSelect": "usd_remaining_4_to_15y_median_else_outstanding_usd_median",
    "componentSotp": "component-sotp/2-factory-nopat-plus-da-minus-sustain",
    "industryOperatingPath": "industry-operating-path/4-auto-through-cycle-300bps",
    "valuationPolicy": "valuation-policy.yaml",
    "valuationPolicyVersion": "valuation-policy/1",
    "shareCount": "current_outstanding_when_near_year_average_else_diluted_was",
    "residualRetention": "median_of_recent_aligned_years_not_latest_trough_payout",
    "stableGrowth": "min_of_macro_and_demonstrated_recent",
    "investmentWave": "capex_spike_or_growth_above_300bps_and_capex_above_maintenance",
    "costOfDebt": "market_yield_then_rated_or_coverage_synthetic_then_accounting_coupon",
    "secularRegime": "median_at_least_10pct_and_three_of_four_years_positive_is_secular_even_if_speed_varies",
    "driverRecentWindowYears": 4,
    "negativeYears": "retained_in_scenario_distribution_and_history_diagnostics",
    "maintenanceCapex": "normalized_capex_intensity * asset_renewal_rate / (asset_renewal_rate + revenue_growth); growth CapEx is earned by revenue growth, never a share of OCF margin",
    "assetRenewalRateBps": 1000,
    "projectionYearsSecularOrOwnerEarnings": 10,
    "acquisitionGrowth": "exclude_only_year_y_minus_1_to_y_when_year_y_is_material",
    "minimumCleanRecentGrowthTransitions": 2,
    "provisionalWaccUplift": "round(175 * min(debt_weight / 0.40, 1))",
    "qaEvidenceCorpus": "shared/contracts/valuation-fcff-qa-2026-07-31.json"
  },
  "driverResolutionContract": {
    "scope": "OperatingNonFinancial only; FinancialServices bypasses FCFF rate resolution",
    "costOfDebtOrder": [
      "market_yield",
      "rated_or_synthetic_spread",
      "sec_interest_over_average_fiscal_close_debt",
      "yahoo_aligned_interest_over_debt",
      "unavailable"
    ],
    "marginalTaxOrder": [
      "tax_reconciliation",
      "jurisdiction_statutory",
      "domicile_tax_proxy",
      "unavailable"
    ],
    "effectiveTaxIsNotMarginalTax": true,
    "missingDebtIsNotZero": true,
    "explicitZeroDebt": "not_applicable",
    "positiveInterestWithZeroDebt": "provider_inconsistent",
    "qualityThresholds": {
      "solidMinimumValidPeriods": 3,
      "provisionalValidPeriods": [1, 2],
      "unavailableValidPeriods": 0
    }
  },
  "downstreamUnavailableContract": {
    "emitsIntrinsic": false,
    "emitsGap": false,
    "contributesScoreAsZero": false,
    "clearsStaleFcffCache": true,
    "analystRangeMayRemainIndependent": true,
    "reasonCodesAreVisible": true
  },
  "exactParityContract": {
    "moneyUnit": "cents",
    "rateUnit": "bps",
    "floatCrossesPublicContract": false,
    "comparison": "exact textual field equality",
    "epsilon": null,
    "oneCentMutationMustFail": true,
    "oneBpMutationMustFail": true
  },
  "operatingValuationRouterContract": {
    "path": "shared/contracts/operating-valuation-router-v1.json",
    "status": "headless_core_only",
    "runtimeIntegrated": false,
    "model": "ForwardEarningsPower",
    "evidenceFamily": "AnalystDerivedModel",
    "priceAndTargetAreEngineInputs": false
  },
  "forbiddenAcceptancePatterns": [
    "assert_intrinsic_over_price_ratio_bounded",
    "min_wacc_floor_as_valuation_truth",
    "sector_fcf_haircut_constant"
  ],
  "classifierCases": [
